[Unit]
Description=PYROS backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=pyros
Group=pyros
WorkingDirectory=/var/www/pyros/backend
EnvironmentFile=/var/www/pyros/backend/.env
ExecStart=/var/www/pyros/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
