[Unit]
Description=PYROS backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
# Match this to whoever owns the repo checkout on the actual server — using a
# dedicated user means chown -R'ing wherever the repo happens to live, which
# is unnecessary risk (e.g. don't chown a real login's home directory to it).
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/firerisk/backend
EnvironmentFile=/home/ubuntu/firerisk/backend/.env
ExecStart=/home/ubuntu/firerisk/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
